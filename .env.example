# ============================================================
# GuardRail — environment variables
# ============================================================
# Copy to .env and fill in your values before running.
#
#   cp .env.example .env
#
# Then apply the DB migration and start the stack:
#   supabase db push  (or paste supabase/migrations/ into the SQL editor)
#   docker compose up --build
#
# All services validate their required variables at startup
# and exit immediately with a clear error if any are missing.
# ============================================================


# ── Supabase (required by proxy, traffic-runner, agent) ─────────────────────
# Cloud project URL — e.g. https://xyzxyzxyz.supabase.co
SUPABASE_URL=

# Service role key (secret) — has full DB access, never expose to the browser
SUPABASE_SERVICE_KEY=

# Anon/public key — safe to expose, used by the Next.js dashboard only
SUPABASE_ANON_KEY=


# ── Auth: service-to-service bearer token (Slice A) ─────────────────────────
# Shared secret for web → agent → proxy admin calls. Server-only: never add a
# NEXT_PUBLIC_ prefix, never commit a real value, never log it.
# Generate one with:  openssl rand -hex 32
# Required by proxy, agent, and web (server-side Route Handlers).
ADMIN_TOKEN=


# ── services/proxy (optional overrides) ─────────────────────────────────────
# Defaults shown below are correct for docker compose networking.
# Only set these if you are running services on non-standard ports.
# PORT=8080
# STABLE_URL=http://stable:8000
# CANARY_URL=http://canary:8000


# ── workers/agent (optional overrides) ──────────────────────────────────────
# PORT=8003
# PROXY_ADMIN_URL=http://proxy:8080/admin/route
# LATENCY_DEGRADATION_FACTOR=2.0


# ── workers/traffic-runner (optional overrides) ──────────────────────────────
# STABLE_URL=http://stable:8000
# CANARY_URL=http://canary:8000
# RUN_ONCE=true          # set to false to loop every INTERVAL_SECONDS
# INTERVAL_SECONDS=30


# ── services/api-demo (optional overrides) ───────────────────────────────────
# BUG_PROFILE is set per-container in docker-compose.yml (stable / canary).
# Only override here if running a single api-demo instance outside compose.
# BUG_PROFILE=stable
